    <RootNamespace>Xaf.EditDraft.Sample.Tests</RootNamespace>
    <AssemblyName>Xaf.EditDraft.Sample.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xaf.EditDraft.Sample.Module\Xaf.EditDraft.Sample.Module.csproj" />
    <ProjectReference Include="..\Xaf.EditDraft.Sample.Blazor.Server\Xaf.EditDraft.Sample.Blazor.Server.csproj" />
  </ItemGroup>
</Project>
