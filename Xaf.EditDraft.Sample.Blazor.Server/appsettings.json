{
  "ConnectionStrings": {
    "ConnectionString": "Data Source=(localdb)\\mssqllocaldb;Integrated Security=SSPI;Pooling=false;Initial Catalog=XafEditDraftSample"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "DevExpress.ExpressApp": "Information",
      "Xaf.EditDraft": "Information"
    }
  },
  "AllowedHosts": "*",
  "EditDraftCapture": {
    "Enabled": true,
    "Types": {
      "Note": {
        "Enabled": true
      }
    },
    "ListViews": {
      "Enabled": true
    },
    "NewRecords": {
      "Enabled": true
    }
  },
  "DevExpress": {
    "ExpressApp": {
      "Languages": "en-US;",
      "ShowLanguageSwitcher": false,
      "ThemeSwitcher": {
        "DefaultItemName": "DevExpress Fluent",
        "ShowSizeModeSwitcher": true,
        "Groups": [
          {
            "IsFluent": true,
            "Caption": "DevExpress Fluent",
            "Items": [
              { "Caption": "Blue", "Color": "Blue" },
              { "Caption": "Cool Blue", "Color": "CoolBlue" },
              { "Caption": "Desert", "Color": "Desert" },
              { "Caption": "Mint", "Color": "Mint" },
              { "Caption": "Moss", "Color": "Moss" },
              { "Caption": "Orchid", "Color": "Orchid" },
              { "Caption": "Purple", "Color": "Purple" },
              { "Caption": "Rose", "Color": "Rose" },
              { "Caption": "Rust", "Color": "Rust" },
              { "Caption": "Steel", "Color": "Steel" },
              { "Caption": "Storm", "Color": "Storm" }
            ]
          }
        ]
      }
    }
  }
}
