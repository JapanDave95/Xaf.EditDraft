<Project>
  <!--
    Central package versions for the library and the sample. The library was extracted from the CareCrew
    solution on 2026-10-03 and these are the versions it was built and tested with there. Xaf.EditDraft.Tests
    opts out of central management (ManagePackageVersionsCentrally=false) and pins its own test packages.
  -->
  <PropertyGroup>
    <DevExpressVersion>26.1.4</DevExpressVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="DevExpress.Drawing.Skia" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.ExpressApp" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.ExpressApp.Blazor" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.ExpressApp.ConditionalAppearance" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.ExpressApp.Security" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.ExpressApp.Security.Xpo" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.ExpressApp.Xpo" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Persistent.Base" Version="$(DevExpressVersion)" />
    <PackageVersion Include="DevExpress.Persistent.BaseImpl.Xpo" Version="$(DevExpressVersion)" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="NUnit" Version="4.1.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageVersion Include="FluentAssertions" Version="6.12.0" />
  </ItemGroup>
</Project>
