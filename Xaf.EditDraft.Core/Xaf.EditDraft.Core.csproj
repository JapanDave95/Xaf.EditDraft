<Project Sdk="Microsoft.NET.Sdk">
    <!-- Xaf.EditDraft.Core: the platform-agnostic part of the edit-draft (入力控) engine (milestone M1,
         docs/xaf-editdraft-library-design-2026-10-01.md).
         Supported contract v1: XAF + XPO, Guid-keyed BaseObject records, SQL Server.
         References DevExpress packages, Newtonsoft.Json and the BCL only; no application assembly and no
         DevExpress.ExpressApp.Blazor* (enforced by EditDraftLibraryIsolationTests).
         Package versions come from Directory.Packages.props (central package management). -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <RootNamespace>Xaf.EditDraft.Core</RootNamespace>
        <AssemblyName>Xaf.EditDraft.Core</AssemblyName>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <IsPackable>true</IsPackable>
        <PackageId>Xaf.EditDraft.Core</PackageId>
        <Description>Edit-draft (unsaved-input) capture and restore engine for DevExpress XAF applications on XPO: policies, server-side capture on ObjectChanged, owner-fenced SQL Server store, restore and new-record recreation. Platform-independent part; pair with Xaf.EditDraft.Blazor.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DevExpress.ExpressApp" />
        <PackageReference Include="DevExpress.ExpressApp.Xpo" />
        <PackageReference Include="DevExpress.Persistent.Base" />
        <PackageReference Include="DevExpress.Persistent.BaseImpl.Xpo" />
        <PackageReference Include="Newtonsoft.Json" />
    </ItemGroup>

    <!-- Owner decision O-3 (milestone M2): the writer is internal to Core. The Blazor part (its restore, list and
         ListView-capture controllers) and the library's own test project, which exercises the writer, may see Core
         internals; no other assembly may (gap G13, 2026-10-04; pinned by EditDraftCloseGapsTests and
         EditDraftLibraryIsolationTests). -->
    <ItemGroup>
        <InternalsVisibleTo Include="Xaf.EditDraft.Blazor" />
        <InternalsVisibleTo Include="Xaf.EditDraft.Tests" />
    </ItemGroup>
</Project>
